# =============================================================================
# Connexios RAG -- Example Environment
# =============================================================================
# Copy to .env and fill in your values.
# =============================================================================

# -- Application --------------------------------------------------------------
APP_NAME="Connexio"
APP_VERSION="0.1"
PRIMARY_LANG="en"
DEFAULT_LANG="en"
INPUT_DEFAULT_MAX_CHARACTERS=500

# -- PostgreSQL (Neon.tech) ---------------------------------------------------
POSTGRES_HOST="[your-neon-host]"
POSTGRES_PORT=5432
POSTGRES_USERNAME="[your-username]"
POSTGRES_PASSWORD="[your-password]"
POSTGRES_MAIN_DATABASE="connexio"

# -- LLM Generation (Groq) ----------------------------------------------------
GENERATION_BACKEND="GROQ"
UTILITY_BACKEND="GROQ"
GROQ_API_URL="https://api.groq.com/openai/v1"
GROQ_API_KEY="[your-groq-api-key]"
GENERATION_MODEL_ID="llama-3.3-70b-versatile"
UTILITY_MODEL_ID="llama-3.1-8b-instant"
GENERATION_DEFAULT_MAX_TOKENS=1024
GENERATION_DEFAULT_TEMPERATURE=0.1

# -- Embeddings + Reranking (Jina AI) -----------------------------------------
EMBEDDING_BACKEND="OPENAI"                    # uses OpenAIProvider pointed at Jina API
JINA_API_KEY="[your-jina-api-key]"            # required for embeddings + reranking
EMBEDDING_MODEL_ID="jina-embeddings-v3"
EMBEDDING_MODEL_SIZE=1024

# -- Vector DB ----------------------------------------------------------------
VECTOR_DB_BACKEND="PGVECTOR"
VECTOR_DB_DISTANCE_METHOD="cosine"
VECTOR_DB_PGVEC_INDEX_THRESHOLD=400
VECTOR_DB_PATH="qdrant_db"                    # Qdrant only

# -- Celery (Upstash Redis) ---------------------------------------------------
# CELERY_BROKER_URL="rediss://..."
# CELERY_RESULT_BACKEND="rediss://..."

# -- Internal Auth ------------------------------------------------------------
CONNEXIO_INTERNAL_API_KEY="[your-api-key]"
JWT_SECRET="[your-jwt-secret]"
SERVICE_USER_ID=11
MAIN_BACKEND_URL=https://connexio.icu

# -- Standalone / Playground Mode --------------------------------------------
# STANDALONE_MODE serves a chat playground at "/" and lets it run without the
# Node.js backend or MasarX. Set the three flags below for a self-contained Space.
# The browser never receives CONNEXIO_INTERNAL_API_KEY: the UI router calls the
# controller in-process, and every service route still enforces the key.
STANDALONE_MODE=false
UI_DEFAULT_USER_ID=11
UI_DEFAULT_PROJECT_ID=0
UI_DEFAULT_PERSONA=student
UI_DEFAULT_LANGUAGE=auto

# -- Integration Toggles ------------------------------------------------------
# Turn these off to run on PostgreSQL + Jina + Groq alone. All call sites
# already None-guard these clients, so disabling is safe.
ENABLE_BACKEND_SYNC=true
ENABLE_MASARX_SYNC=true
# Read by start.sh. Only gates the background worker (file indexing + scheduled
# maintenance); chat answering is served entirely by uvicorn.
ENABLE_CELERY=true

# -- File Processing ----------------------------------------------------------
FILE_ALLOWED_TYPES=["application/pdf","text/plain"]
FILE_MAX_SIZE=15
FILE_DEFAULT_CHUNK_SIZE=1024

# -- CRAG Tool Keys (optional) ------------------------------------------------
# SERPAPI_API_KEY="..."
# GITHUB_TOKEN="..."
# STACKOVERFLOW_API_KEY="..."

# -- Sentry (optional) --------------------------------------------------------
# SENTRY_DSN="https://..."
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
