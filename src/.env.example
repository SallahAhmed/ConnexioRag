=
OPENAI_API_KEY=""
OPENAI_API_URL=
COHERE_API_KEY=""
SERPAPI_API_KEY=""
GITHUB_TOKEN="" # Required for GitHub tool
=
GENERATION_MODEL_ID_LITERAL=["gpt-3.5-turbo-0125", "openai/gpt-oss-120b"]
