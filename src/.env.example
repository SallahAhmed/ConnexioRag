APP_NAME="Connexio"
APP_VERSION="0.1"
OPEN_API_KEY=""

FILE_ALLOWED_TYPES=["text/plain", "application/pdf"]
FILE_MAX_SIZE=10
FILE_DEFAULT_CHUNK_SIZE=512000 # 512Kb

POSTGRES_USERNAME=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_MAIN_DATABASE=

# MONGODB_URL="mongodb://localhost:"
# MONGODB_DATABASE="" 

# ========================= LLM Config =========================
GENERATION_BACKEND = "OPENAI"
EMBEDDING_BACKEND = "COHERE"

OPENAI_API_KEY=""
OPENAI_API_URL=
COHERE_API_KEY=""
SERPAPI_API_KEY=""
GITHUB_TOKEN="" # Required for GitHub tool

# Models for Groq: llama-3.3-70b-versatile, deepseek-r1-distill-llama-70b, llama-3.1-8b-instant
GENERATION_MODEL_ID="llama-3.3-70b-versatile"
UTILITY_MODEL_ID="llama-3.1-8b-instant"
EMBEDDING_MODEL_ID="bge-m3"
